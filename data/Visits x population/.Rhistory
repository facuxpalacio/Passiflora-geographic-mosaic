rho_df <- read.table("C:/RD/bird_rho.txt", head = T)
rho <- rho_df$rho
names(rho) <- rho_df$code
length(rho)
### Local abundance
pool_df <- read.table("C:/RD/pops_pool.txt", head = T)
log_pool <- t(log(pool_df[,-c(1,2)] + 1))
dim(log_pool)
### Binary mask for the distribution of species across populations
presence_by_pop <- read.table("C:/RD/presence_by_pop.txt", head = T)
presence_by_pop <- t(presence_by_pop[, -c(1:2)])
dim(presence_by_pop)
