# Add these 2 populations as new rows
align_vec <- function(v, comp_mat) {
aligned <- setNames(rep(0, ncol(comp_mat)), colnames(comp_mat))
common <- intersect(names(v), colnames(comp_mat))
aligned[common] <- v[common]
return(matrix(aligned, nrow = 1, dimnames = list(NULL, colnames(comp_mat))))
}
row1 <- align_vec(pop_9, comp_mat)
row2 <- align_vec(pop_10, comp_mat)
comp_mat <- rbind(
comp_mat,
pop_9 = row1,
pop_10 = row2
)
