birdtraits <- read.table("C:/RD/frugivore_traits.txt", header = TRUE)
traits <- birdtraits[, c("handling", "BodyMass.Value")]
rownames(traits) <- birdtraits$code   # usar código de especie como rownames
# Community matrix con abundancias
comm_matrix <- read.csv("C:/RD/comm_passionflower.csv")
comm <- comm_matrix[, -1]             # eliminar columna de nombres si existe
rownames(comm) <- comm_matrix$X       # nombre de los sitios
# Filtrar y reordenar para coincidir
comm <- comm[, colnames(comm) %in% rownames(traits)]
traits <- traits[colnames(comm), ]
# ---- PROMEDIO NO PONDERADO ----
mean_mass_unweighted <- apply(comm, 1, function(x) {
species_present <- names(x)[x > 0]          # especies presentes
trait_values <- traits[species_present, "BodyMass.Value"]
mean(trait_values, na.rm = TRUE)
})
# Matriz de diferencias absolutas entre ensamblajes
n_sites <- nrow(comm)
site_names <- rownames(comm)
bodymass_diff_unweighted <- matrix(
NA, n_sites, n_sites,
dimnames = list(site_names, site_names)
)
for(i in 1:n_sites){
for(j in 1:n_sites){
bodymass_diff_unweighted[i, j] <-
abs(mean_mass_unweighted[i] - mean_mass_unweighted[j])
}
}
# Convertir a data frame para GDM
bodymass_diff_df <- as.data.frame(bodymass_diff_unweighted)
write.csv(bodymass_diff_df, "beta_FD_meanBodyMass.csv")
