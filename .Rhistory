0,
n_species,
n_pops
)
for(i in 1:n_species){
for(k in 1:n_pops){
lambda_sim[i,k] <-
w_sim[i,k] *
exp(
alpha_sim[k] +
beta_sim[k] *
log_pool_sim[i,k]
)
N_sim[i,k] <- rpois(
1,
lambda_sim[i,k]
)
}
}
# Simulate visits observed
C_sim <- array(
0,
dim=c(
n_species,
max(n_plants),
n_pops
)
)
for(k in 1:n_pops){
for(i in 1:n_species){
for(j in 1:n_plants[k]){
C_sim[i,j,k] <-
rbinom(
1,
N_sim[i,k],
p_sim[i]
)
}
}
}
# Add augmented species
n_aug <- 20
n_species_aug <- n_species + n_aug
C_aug <- array(
0,
dim=c(
n_species_aug,
max(n_plants),
n_pops
)
)
C_aug[1:n_species,,] <- C_sim
log_pool_aug <- rbind(
log_pool_sim,
matrix(
rep(colMeans(log_pool_sim), each=n_aug),
n_aug,
n_pops
)
)
rho_aug <- c(
rho_sim,
rep(mean(rho_sim), n_aug)
)
presence_aug <- matrix(
1,
n_species_aug,
n_pops
)
# Data list
data_list_sim <- list(
C = C_aug,
log_pool = log_pool_aug,
rho = rho_aug,
n_species_aug = n_species_aug,
n_pops = n_pops,
n_plants = n_plants,
presence_by_pop = presence_aug
)
# Make inits
make_inits_sim <- function(C, presence, rho){
omega_init <- runif(n_pops, 0.1, 0.9)
# Latent presence
w_raw_init <- matrix(
0,
n_species_aug,
n_pops
)
for(i in 1:n_species_aug){
for(k in 1:n_pops){
obs <- C[i,,k]
obs <- obs[!is.na(obs)]
maxC <- ifelse(length(obs)==0,0,max(obs))
if(maxC > 0){
# detected species must be present
w_raw_init[i,k] <- 1
} else {
# possible presence
w_raw_init[i,k] <- rbinom(
1,
1,
omega_init[k] * rho[i]
)
}
}
}
# Abundance initial values
N_init <- matrix(
0,
n_species_aug,
n_pops
)
for(i in 1:n_species_aug){
for(k in 1:n_pops){
obs <- C[i,,k]
obs <- obs[!is.na(obs)]
maxC <- ifelse(length(obs)==0,0,max(obs))
if(presence[i,k]==1 &&
w_raw_init[i,k]==1){
# must be >= observed counts
N_init[i,k] <- max(
maxC,
1
) + 20
} else {
N_init[i,k] <- 0
}
}
}
list(
w_raw = w_raw_init,
N_actual = N_init,
eta = rnorm(n_species_aug, 0, 1),
alpha = rnorm(n_pops,0,1),
beta = rnorm(
n_pops,0,1),
omega = omega_init,
mu_alpha = 0,
sigma_alpha = 1,
mu_beta = 0,
sigma_beta = 1,
mu_eta = 0,
sigma_eta = 1
)
}
inits_sim <- list(
make_inits_sim(
C_aug,
presence_aug,
rho_aug
),
make_inits_sim(
C_aug,
presence_aug,
rho_aug
),
make_inits_sim(
C_aug,
presence_aug,
rho_aug
)
)
# Model fit
fit_sim <- jags(
data = data_list_sim,
inits = inits_sim,
parameters.to.save = params,
model.file = "model.txt",
n.chains = 3,
n.iter = 20000,
n.burnin = 5000,
n.thin = 5
)
# Parameters monitored
params <- c(
"w",
"N_actual",
"lambda_potential",
"lambda_actual",
"p",        # now p[i] only
"eta",
"mu_eta",
"sigma_eta",
"alpha",
"beta",
"omega",
"mu_alpha",
"sigma_alpha",
"mu_beta",
"sigma_beta"
)
# Model fit
fit_sim <- jags(
data = data_list_sim,
inits = inits_sim,
parameters.to.save = params,
model.file = "model.txt",
n.chains = 3,
n.iter = 20000,
n.burnin = 5000,
n.thin = 5
)
write.csv(fit_sim$BUGSoutput$summary, "mcmc_sim2.csv")
save(fit_sim, file = "fit_sim_R2jags2.RData")
