select(all_of(traits), W) %>%
drop_na()
if (nrow(dat) < 3) return(NULL)
res <- moments.differentials(
z = dat[, traits],
W = dat$W,
n.boot = 1000,
standardized = FALSE
)
res %>%
tibble::rownames_to_column("term") %>%
filter(term %in% c("B1", "B2", "G1", "G2")) %>%
mutate(
populationID = pop,
trait = case_when(
term == "B1" ~ "fruit_crop",
term == "B2" ~ "xDiam"
),
differential = case_when(
grepl("^B", term) ~ "B",
grepl("^G", term) ~ "G"
),
.before = 1
)
})
