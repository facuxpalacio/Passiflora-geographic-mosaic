dim(lin_grad) # first column = site
##### Nonlinear gradient matrix (response 2)
nonlin_grad <- read.csv(here("data", "gamma_sim.csv"))
nonlin_grad[, -1] <- 1 - nonlin_grad[, -1]
nonlin_grad$populationID <- 1:nrow(nonlin_grad)
colnames(nonlin_grad) <- c("site", nonlin_grad$populationID)
dim(nonlin_grad) # first column = site
##### Beta-diversity (Bray-Curtis) (predictor 1)
beta_div <- read.csv(here("data", "comp_div.csv"))[,-1]
rownames(beta_div) <- colnames(beta_div)
dim(beta_div)
# Order rows/columns alphabetically
ord <- order(rownames(beta_div))
beta_div <- beta_div[ord, ord]
# Create numeric site IDs
sites_char <- rownames(beta_div)
sites_num  <- 1:length(sites_char)
# Create numeric-labeled distance matrix for GDM
beta_div_numeric <- beta_div
rownames(beta_div_numeric) <- sites_num
colnames(beta_div_numeric) <- sites_num
# Add "site" column (REQUIRED)
beta_div_numeric <- data.frame(site = sites_num,
beta_div_numeric)
#### Functional diversity (proportion of gulpers) (predictor 2)
FD_hand <- read.csv(here("data", "beta_FD_propGulpers.csv"))[,-1]
rownames(FD_hand) <- colnames(FD_hand)
dim(FD_hand)
# Order rows/columns alphabetically
ord <- order(rownames(FD_hand))
FD_hand <- FD_hand[ord, ord]
# Create numeric site IDs
sites_char <- rownames(FD_hand)
sites_num  <- 1:length(FD_hand)
# Create numeric-labeled distance matrix for GDM
FD_hand_numeric <- FD_hand
rownames(FD_hand_numeric) <- sites_num
colnames(FD_hand_numeric) <- sites_num
# Add "site" column (REQUIRED)
FD_hand_numeric <- data.frame(site = sites_num, FD_hand_numeric)
#### Functional diversity (mean body mass) (predictor 3)
FD_BM <- read.csv(here("data", "beta_FD_meanBodyMass.csv"))[,-1]
rownames(FD_BM) <- colnames(FD_BM)
# Order rows/columns alphabetically
ord <- order(rownames(FD_BM))
FD_BM <- FD_BM[ord, ord]
# Create numeric site IDs
sites_char <- rownames(FD_BM)
sites_num  <- 1:length(FD_BM)
# Create numeric-labeled distance matrix for GDM
FD_BM_numeric <- FD_BM
rownames(FD_BM_numeric) <- sites_num
colnames(FD_BM_numeric) <- sites_num
# Add "site" column (REQUIRED)
FD_BM_numeric <- data.frame(site = sites_num, FD_BM_numeric)
dim(FD_BM_numeric)
##### Population density (predictor 4)
populationID <- c("Carlos_Pellegrini", "El_Carmen", "El_Rodeo",
"La_Plata", "La_Paz", "Magdalena", "Ranchos",
"Tucuman", "Santa_Fe","Sauce_Montrull")
pop_density <- c(760, 134, 910, 4115, 239,
0, 874, 5445, 1507, 695)
pop_df <- data.frame(populationID, pop_density)
log_pop <- log(pop_df$pop_density + 1)
# pairwise absolute log-differences
pop_dist <- as.data.frame(
as.matrix(dist(log_pop, method = "euclidean"))
)
rownames(pop_dist) <- populationID
colnames(pop_dist) <- populationID
pop_dist <- data.frame(populationID, pop_dist)
pop_dist$populationID <- 1:nrow(pop_dist)
colnames(pop_dist) <- c("site", pop_dist$populationID)
dim(pop_dist) # first column = site
##### Geographic coordinates (predictor 5)
plant_data <- read.csv(here("data", "Passionflower_pops.csv"))
coords <- plant_data %>%
group_by(populationID) %>%
summarise(
Long = mean(as.numeric(longitude), na.rm = TRUE),
Lat  = mean(as.numeric(latitude), na.rm = TRUE)
)
coords$populationID <- c("CP", "EC", "ER", "LZ", "LP", "MG", "RA",
"SF", "SM", "TU")
coords[10, 2] <- -65.26979233 # Longitude Tucuman
coords[10, 3] <- -26.80470395 # Latitude Tucuman
coords[c(4,5), ] <- coords[c(5,4), ] # switch LZ and LP
predData <- data.frame(
site = sites_num,
Long = coords$Long,
Lat  = coords$Lat
)
# Coordinate projection
pts <- st_as_sf(predData, coords = c("Long", "Lat"), crs = 4326)
# Project to Argentina TM (EPSG:5347)
pts_proj <- st_transform(pts, 5347)
# Extract projected coordinates back to a data frame
coords <- st_coordinates(pts_proj)
predData_proj <- data.frame(
site = predData$site,
Long = coords[,1],
Lat  = coords[,2]
)
geo_dist <- as.matrix(dist(coords))
rownames(geo_dist) <- populationID
colnames(geo_dist) <- populationID
geo_dist <- data.frame(populationID, geo_dist)
geo_dist$populationID <- 1:nrow(geo_dist)
colnames(geo_dist) <- c("site", geo_dist$populationID)
dim(geo_dist) # first column = site
#### Functional diversity (foraging stratum) (predictor 6)
FD_strat <- read.csv(here("data", "beta_FD_ForStrat.csv"))[,-1]
rownames(FD_strat) <- colnames(FD_strat)
# Order rows/columns alphabetically
ord <- order(rownames(FD_strat))
FD_strat <- FD_strat[ord, ord]
# Create numeric site IDs
sites_char <- rownames(FD_strat)
sites_num  <- 1:length(FD_strat)
# Create numeric-labeled distance matrix for GDM
FD_strat_numeric <- FD_strat
rownames(FD_strat_numeric) <- sites_num
colnames(FD_strat_numeric) <- sites_num
# Add "site" column (REQUIRED)
FD_strat_numeric <- data.frame(site = sites_num, FD_strat_numeric)
dim(FD_strat_numeric)
#### Functional diversity (fruit harvesting) (predictor 7)
FD_harv <- read.csv(here("data", "beta_FD_fruit_acq.csv"))[,-1]
rownames(FD_harv) <- colnames(FD_harv)
# Order rows/columns alphabetically
ord <- order(rownames(FD_harv))
FD_harv <- FD_strat[ord, ord]
# Create numeric site IDs
sites_char <- rownames(FD_harv)
sites_num  <- 1:length(FD_harv)
# Create numeric-labeled distance matrix for GDM
FD_harv_numeric <- FD_harv
rownames(FD_harv_numeric) <- sites_num
colnames(FD_harv_numeric) <- sites_num
# Add "site" column (REQUIRED)
FD_harv_numeric <- data.frame(site = sites_num, FD_harv_numeric)
dim(FD_harv_numeric)
##### Phylogenetic distance (predictor 8)
phyD <- read.csv(here("data", "phylo_dist.csv"))[,-1]
# Order rows/columns alphabetically
ord <- order(rownames(phyD))
phyD <- phyD[ord, ord]
# Create numeric site IDs
sites_char <- rownames(phyD)
sites_num  <- 1:length(sites_char)
# Create numeric-labeled distance matrix for GDM
phyD_numeric <- phyD
rownames(phyD_numeric) <- sites_num
colnames(phyD_numeric) <- sites_num
# Add "site" column (REQUIRED)
phyD_numeric <- data.frame(site = sites_num,
phyD_numeric)
# Create initial site-pair table for linear gradients (bioFormat = 3)
gdmTab1 <- formatsitepair(
bioData = lin_grad,     # biological distance matrix + site column
bioFormat = 3,
XColumn = "Long",
YColumn = "Lat",
siteColumn = "site",
predData  = predData_proj      # coordinates table
)
# bioFormat = 4
## adds a predictor matrix to an existing site-pair table, in this case,
## predData needs to be provided, but is not actually used
# Combine predictors into a list
distPreds_list <- list(geo_dist,
beta_div_numeric,
FD_hand_numeric,
FD_BM_numeric,
FD_strat_numeric,
FD_harv_numeric,
phyD_numeric,
pop_dist)
# Build the GDM site-pair table
gdmTab2 <- formatsitepair(
bioData = gdmTab1,     # dissimilarity matrix with 'site' column
bioFormat = 4,            # dissimilarity matrix
siteColumn = "site",
predData  = predData_proj,    # REQUIRED for format 4
distPreds = distPreds_list
)
##### Fit GDM
gdmTabMod_lin <- gdm(gdmTab2, geo = F)
# Percent Deviance Explained: goodness-of-fit
# Intercept: expected dissimilarity between sites that do not differ in the predictors
# Summary of the fitted I-splines for each predictor, including the values of the
# coefficients and their sum.
# The sum indicates the amount of compositional turnover associated with that variable,
# holding all other variables constant. I-spline summaries are order by coefficient sum.
# Variables with all coefficients=0 have no relationship with the modeled biological pattern.
summary(gdmTabMod_lin)
gdmTabMod_nonlin <- gdm(gdmTab4, geo = F)
##### Fit GDM
gdmTabMod_lin <- gdm(gdmTab2, geo = F)
# Percent Deviance Explained: goodness-of-fit
# Intercept: expected dissimilarity between sites that do not differ in the predictors
# Summary of the fitted I-splines for each predictor, including the values of the
# coefficients and their sum.
# The sum indicates the amount of compositional turnover associated with that variable,
# holding all other variables constant. I-spline summaries are order by coefficient sum.
# Variables with all coefficients=0 have no relationship with the modeled biological pattern.
summary(gdmTabMod_lin)
# Plots
gdm.1.splineDat <- isplineExtract(gdmTabMod_lin)
df_spline_geo <- data.frame(x = gdm.1.splineDat$x[, "matrix_1"],
y = gdm.1.splineDat$y[, "matrix_1"])
df_points_geo <- gdmTab2 %>%
mutate(
geo_dist = sqrt((s1.xCoord - s2.xCoord)^2 + (s1.yCoord - s2.yCoord)^2)
)
ggplot() +
geom_point(
data = df_points_geo,
aes(x = geo_dist, y = distance),
size = 3
) +
geom_line(
data = df_spline_geo,
aes(x = x, y = y),
linewidth = 1.2
) +
labs(
x = "Geographic distance (projected meters)",
y = "Linear gradient dissimilarity") +
theme_bw()
