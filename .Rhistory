geom_smooth(
method = "lm",
se = FALSE
) +
annotate(
"text",
x = Inf,
y = Inf,
label = label,
hjust = 1.1,
vjust = 1.3,
size = 3.5
) +
labs(
x = "Latitude",
y = if (i == 1) {
"Aridity index"
} else {
sub("wc2\\.1_5m_", "", v)
}
) +
scale_x_continuous(
breaks = 3,
labels = function(x) x / 1e6
)
})
head(datos_bio)
# combine with original data
datos_bio <- cbind(
coords[, 2:3],
aridity_values,
bio_values[, -1]
)
# environmental variables
env_vars <- c("awi_pm_sr_yr", grep(
"^wc2\\.1_5m_bio_",
names(datos_bio),
value = TRUE
))
# Make a plot for each variable across latitude
plots <- lapply(seq_along(env_vars), function(i) {
v <- env_vars[i]
# Variable Y
y_var <- if (i == 1) "awi_pm_sr_yr" else v
# Correlation
test <- cor.test(
datos_bio$Y,
datos_bio[[y_var]],
method = "pearson"
)
r <- unname(test$estimate)
p <- test$p.value
# Text
label <- paste0(
"r = ", round(r, 2),
"\np = ", format.pval(p, digits = 2, eps = 0.001)
)
ggplot(datos_bio, aes(x = Y, y = .data[[y_var]])) +
geom_point(size = 3) +
geom_smooth(
method = "lm",
se = FALSE
) +
annotate(
"text",
x = Inf,
y = Inf,
label = label,
hjust = 1.1,
vjust = 1.3,
size = 3.5
) +
labs(
x = "Latitude",
y = if (i == 1) {
"Aridity index"
} else {
sub("wc2\\.1_5m_", "", v)
}
) +
scale_x_continuous(
breaks = 3,
labels = function(x) x / 1e6
)
})
