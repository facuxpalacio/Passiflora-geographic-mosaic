make_inits_sim <- function(
C,
presence,
n_species,
n_pops
) {
N_init <- matrix(
0,
nrow = n_species,
ncol = n_pops
)
for (i in 1:n_species) {
for (k in 1:n_pops) {
obs <- C[i, , k]
obs <- obs[!is.na(obs)]
maxC <- ifelse(
length(obs) == 0,
0,
max(obs)
)
if (presence[i, k] == 1) {
N_init[i, k] <-
max(maxC, 1) +
rpois(1, 2)
} else {
N_init[i, k] <- 0
}
}
}
list(
N = N_init,
alpha = rnorm(
1,
0,
0.5
),
beta = rnorm(
1,
1,
0.3
),
p = runif(
1,
0.4,
0.8
)
)
}
##################################################################
### 9. THREE CHAINS
##################################################################
inits_sim <- list(
make_inits_sim(
C_sim,
presence_by_pop_true,
n_species,
n_pops
),
make_inits_sim(
C_sim,
presence_by_pop_true,
n_species,
n_pops
),
make_inits_sim(
C_sim,
presence_by_pop_true,
n_species,
n_pops
)
)
##################################################################
### 10. JAGS MODEL
##################################################################
cat("
model {
############################################################
# Ecological process
############################################################
for (k in 1:n_pops) {
for (i in 1:n_species) {
########################################################
# Regional abundance
########################################################
lambda[i,k] <- presence_by_pop[i,k] * exp(
alpha +
beta * log_pool_c[i,k] +
gamma * rho[i]
)
########################################################
# Latent abundance
########################################################
N[i,k] ~ dpois(
lambda[i,k]
)
########################################################
# Observations
########################################################
for (j in 1:n_plants[k]) {
C[i,j,k] ~ dbin(
p,
N[i,k]
)
}
}
}
############################################################
# Global ecological parameters
############################################################
alpha ~ dnorm(
0,
0.01
)
beta ~ dnorm(
0,
0.01
)
gamma ~ dnorm(
0,
0.01
)
############################################################
# COMMON DETECTION PROBABILITY
############################################################
p ~ dbeta(
1,
1
)
}
", file = "Nmix_C_common_p_beta_rho.txt")
##################################################################
### 11. PARAMETERS TO MONITOR
##################################################################
params <- c(
"alpha",
"beta",
"gamma",
"p",
"N"
)
fit_sim <- jags(
data = data_list_sim,
inits = inits_sim,
parameters.to.save = params,
model.file = "Nmix_C_common_p_beta_rho.txt",
n.chains = 3,
n.iter = 20000,
n.burnin = 5000,
n.thin = 5
)
post <- fit_sim$BUGSoutput$sims.list
metrics <- as.data.frame(
fit_sim$BUGSoutput$summary
)
metrics_N <- metrics %>%
filter(
grepl(
"^N\\[\\d+,\\d+\\]$",
rownames(.)
)
)
pct_neff <- mean(
metrics_N$n.eff < 100,
na.rm = TRUE
) * 100
pct_rhat <- mean(
metrics_N$Rhat > 1.1,
na.rm = TRUE
) * 100
p1 <- ggplot(
metrics_N,
aes(x = n.eff)
) +
geom_histogram(
bins = 30,
fill = "steelblue",
color = "black"
) +
labs(
title = "Effective sample size for N",
subtitle = sprintf(
"%.1f%% of posteriors with Neff < 100",
pct_neff
),
x = "Neff",
y = "Frequency"
) +
theme_minimal()
p2 <- ggplot(
metrics_N,
aes(x = Rhat)
) +
geom_histogram(
bins = 30,
fill = "tomato",
color = "black"
) +
labs(
title = "Rhat for N",
subtitle = sprintf(
"%.1f%% of parameters with Rhat > 1.1",
pct_rhat
),
x = "Rhat",
y = "Frequency"
) +
theme_minimal()
p1 + p2
build_recovery_df <- function(
posterior,
true_vals,
param_name
) {
posterior <- as.matrix(
posterior
)
n <- ncol(
posterior
)
mean_est <- apply(
posterior,
2,
mean
)
lo <- apply(
posterior,
2,
quantile,
probs = 0.025
)
hi <- apply(
posterior,
2,
quantile,
probs = 0.975
)
data.frame(
group = param_name,
index = 1:n,
true = as.vector(
true_vals
),
mean = mean_est,
lo = lo,
hi = hi,
covered =
as.vector(true_vals) >= lo &
as.vector(true_vals) <= hi
)
}
recovery_alpha <- build_recovery_df(
posterior = post$alpha,
true_vals = alpha_true,
param_name = "alpha"
)
recovery_beta <- build_recovery_df(
posterior = post$beta,
true_vals = beta_true,
param_name = "beta"
)
gamma_mean <- mean(
post$gamma
)
gamma_lo <- quantile(
post$gamma,
0.025
)
gamma_hi <- quantile(
post$gamma,
0.975
)
recovery_gamma <- data.frame(
group = "gamma",
index = 1,
true = gamma_true,
mean = gamma_mean,
lo = gamma_lo,
hi = gamma_hi,
covered =
gamma_true >= gamma_lo &
gamma_true <= gamma_hi
)
p_mean <- mean(
post$p
)
p_lo <- quantile(
post$p,
0.025
)
p_hi <- quantile(
post$p,
0.975
)
recovery_p <- data.frame(
group = "p",
index = 1,
true = p_true,
mean = p_mean,
lo = p_lo,
hi = p_hi,
covered =
p_true >= p_lo &
p_true <= p_hi
)
N_est <- apply(
post$N,
c(2, 3),
mean
)
N_lo <- apply(
post$N,
c(2, 3),
quantile,
probs = 0.025
)
N_hi <- apply(
post$N,
c(2, 3),
quantile,
probs = 0.975
)
recovery_N <- data.frame(
group = "N",
index = 1:length(
N_true
),
true = as.vector(
N_true
),
mean = as.vector(
N_est
),
lo = as.vector(
N_lo
),
hi = as.vector(
N_hi
),
covered =
as.vector(N_true) >=
as.vector(N_lo) &
as.vector(N_true) <=
as.vector(N_hi)
)
recovery_all <- bind_rows(
recovery_alpha,
recovery_beta,
recovery_gamma,
recovery_p,
recovery_N
)
recovery_all$group <- factor(
recovery_all$group,
levels = c(
"alpha",
"beta",
"gamma",
"p",
"N"
)
)
p_recovery <- ggplot(
recovery_all,
aes(
x = true,
y = mean,
ymin = lo,
ymax = hi,
color = covered
)
) +
geom_abline(
slope = 1,
intercept = 0,
linetype = "dashed",
color = "grey50",
linewidth = 1
) +
geom_pointrange(
alpha = 0.7,
linewidth = 0.7
) +
facet_wrap(
~group,
scales = "free",
ncol = 3
) +
scale_color_manual(
values = c(
"TRUE" = "steelblue",
"FALSE" = "firebrick"
)
) +
labs(
title = "Parameter recovery",
x = "True value",
y = "Posterior mean (95% CI)",
color = "Within 95% CI"
) +
theme_minimal() +
theme(
plot.title = element_text(
size = 18,
face = "bold"
),
axis.title = element_text(
size = 15
),
axis.text = element_text(
size = 12
),
legend.title = element_text(
size = 14
),
legend.text = element_text(
size = 12
),
strip.text = element_text(
size = 14,
face = "bold"
)
)
p_recovery
safe_cor <- function(
x,
y
) {
if (
sd(x) == 0 ||
sd(y) == 0
) {
return(
NA_real_
)
}
cor(
x,
y
)
}
corr_N_p <- matrix(
NA,
nrow = n_species,
ncol = n_pops
)
for (i in 1:n_species) {
for (k in 1:n_pops) {
corr_N_p[i, k] <- safe_cor(
post$N[, i, k],
post$p
)
}
}
df_N_p <- data.frame(
index = 1:length(
corr_N_p
),
species = rep(
1:n_species,
times = n_pops
),
population = rep(
1:n_pops,
each = n_species
),
correlation = as.vector(
corr_N_p
),
pair = "N vs p"
)
mean_abs_N_p <- mean(
abs(
df_N_p$correlation
),
na.rm = TRUE
)
max_abs_N_p <- max(
abs(
df_N_p$correlation
),
na.rm = TRUE
)
pct_strong_N_p <- mean(
abs(
df_N_p$correlation
) > 0.5,
na.rm = TRUE
) * 100
cat(
"\n---------------------------------------------\n"
)
cat(
"POSTERIOR CORRELATION: N vs COMMON p\n"
)
cat(
"---------------------------------------------\n"
)
cat(
"Mean absolute correlation:",
round(mean_abs_N_p, 3),
"\n"
)
cat(
"Maximum absolute correlation:",
round(max_abs_N_p, 3),
"\n"
)
cat(
"Percentage with |r| > 0.5:",
round(pct_strong_N_p, 1),
"%\n"
)
