plant_data <- read.csv(here("data", "Passionflower_pops.csv"))
coords <- plant_data %>%
group_by(populationID) %>%
summarise(
Long = mean(as.numeric(longitude), na.rm = TRUE),
Lat  = mean(as.numeric(latitude), na.rm = TRUE)
)
coords$populationID <- c("CP", "EC", "ER", "LZ", "LP", "MG", "RA",
"SF", "SM", "TU")
coords[10, 2] <- -65.26979233 # Longitude Tucuman
coords[10, 3] <- -26.80470395 # Latitude Tucuman
coords[c(4,5), ] <- coords[c(5,4), ] # switch LZ and LP
# Obtain environmental data
bio <- worldclim_global(
var = "bio",
res = 5,
path = "WorldClim"
)
# convert coords to spatial points
pts <- vect(
coords,
geom = c("Long", "Lat"),
crs = "EPSG:4326"
)
# extract 19 bioclimatic variables
bio_values <- terra::extract(bio, pts)
# extract aridity index
ai <- terra::rast(here("data", "ai_v31_yr.tif"))
aridity_values <- terra::extract(ai, pts)
head(aridity_values)
# combine with original data
datos_bio <- cbind(
coords[, 2:3],
awi_pm_sr_yr = aridity_values$awi_pm_sr_yr,
bio_values[, -1]
)
head(datos_bio)
# Make a plot for each variable across latitude
plots <- lapply(seq_along(env_vars), function(i) {
v <- env_vars[i]
# Variable Y
y_var <- if (i == 1) "awi_pm_sr_yr" else v
# Correlation
test <- cor.test(
datos_bio$Lat,
datos_bio[[y_var]],
method = "pearson"
)
r <- unname(test$estimate)
p <- test$p.value
# Text
label <- paste0(
"r = ", round(r, 2),
"\np = ", format.pval(p, digits = 2, eps = 0.001)
)
ggplot(datos_bio, aes(x = Lat, y = .data[[y_var]])) +
geom_point(size = 3) +
geom_smooth(
method = "lm",
se = FALSE
) +
annotate(
"text",
x = Inf,
y = Inf,
label = label,
hjust = 1.1,
vjust = 1.3,
size = 3.5
) +
labs(
x = "Latitude",
y = if (i == 1) {
"Aridity index"
} else {
sub("wc2\\.1_5m_", "", v)
}
) +
scale_x_continuous(
breaks = 3,
labels = function(x) x / 1e6
)
})
wrap_plots(plots, ncol = 4)
