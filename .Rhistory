new_data <- data.frame(Species = na.traits$Species,
Beak.Length_Culmen = na.traits$bill_length_mm,
Wing.Length = na.traits$wing_length_mm,
Tarsus.Length = na.traits$tarsus_length_mm)
ncampo <- nrow(new_data)
new_data <- rbind(new_data,
avo.sp[, c("Species", "Beak.Length_Culmen",
"Wing.Length", "Tarsus.Length")])
navonet <- nrow(avo.sp)
new_data$medida <- c(rep("campo", ncampo),
rep("avonet", navonet))
na.data <- na.omit(new_data)
pca <- princomp(na.data[, 2:4], cor = T)
summary(pca)
biplot(pca)
comp <- as.data.frame(pca$scores[,1:2])
comp$Species <- na.data$Species
comp$medida <- na.data$medida
comp_avo <- subset(comp, medida == "avonet")
medias_comp_avo <- comp_avo %>% group_by(Species) %>%
summarise(Comp.1 = mean(Comp.1), Comp.2 = mean(Comp.2))
comp_campo <- subset(comp, medida == "campo")
ggplot() +
# field data
geom_point(data = comp_campo,
aes(x = Comp.1, y = Comp.2, col = Species)) +
# averages avonet
geom_point(data = medias_comp_avo,
aes(x = Comp.1, y = Comp.2, col = Species, size = 2)) +
# ellipses avonet
stat_ellipse(data = comp_avo,
aes(x = Comp.1, y = Comp.2, col = Species),
type = "norm", # Normal distribution-based ellipse
level = 0.95, # 95% confidence level
linetype = "dashed")
