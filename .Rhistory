}),
k_val = map_int(data_scaled, ~ round(nrow(.x) / 4)),
gam_fit = map2(
data_scaled,
k_val,
~ gam(
W ~ s(zcrop, k = .y) + s(zdiam, k = .y),
family = nb(), data = .x
)
)
)
