ggplot() +
geom_sf(
data = arg,
fill = "grey95",
color = "grey60",
linewidth = 0.3
) +
geom_point(
data = plot_dat_quad,
aes(
x = Long,
y = Lat,
size = abs(estimates),
fill = estimates,
alpha = alpha_val
),
shape = 21,
color = "black"
) +
scale_fill_gradientn(
colours = c("blue", "white", "red"),
values = rescale(c(-max_abs_quad, 0, max_abs_quad)),
name = "Quadratic selection\n(γii)"
) +
scale_size_continuous(
name = "Selection intensity"
) +
scale_alpha_identity() +
facet_wrap(~trait) +
coord_sf(
xlim = range(plot_dat_quad$Long) + c(-2,2),
ylim = range(plot_dat_quad$Lat) + c(-2,2)
) +
theme_classic() +
labs(
x = "Longitude",
y = "Latitude"
) +
theme(
legend.position = "right"
)
library(tidyverse) # data handling
library(dplyr) # data handling
library(tidyr) # data handling
library(purrr) # data handling
library(ggplot2) # plots
library(mgcv) # GAMs
library(gratia) # GAMs
library(boot) # bootstrapping
library(numDeriv) # partial derivatives
library(pheatmap) # heatmaps
library(picante) # phylogenetic trees
library(phytools) # phylogenetic trees
library(gdm) # GDM
library(here) # for path reading
library(sf) # coordinate projection
library(rnaturalearth) # maps
library(stringr) # string handling
library(scales) # colors
knitr::opts_chunk$set(
echo = TRUE,
warning = FALSE,
message = FALSE,
fig.width = 7,
fig.height = 5,
fig.align = "center"
)
fruit_data <- read.csv(here("data", "Passionflower_full.csv"))
# Compute mean trait values per plant
mean_plant_data <- fruit_data %>%
group_by(populationID, plantID) %>%
summarise(
xDiam   = mean(diam_mm, na.rm = TRUE),
xSugar  = mean(sugar_brix, na.rm = TRUE),
.groups = "drop"
)
# Sample sizes per population
fruit_data %>%
group_by(populationID) %>%
summarise(n_fruit = n())
mean_plant_data %>%
group_by(populationID) %>%
nest() %>%
mutate(
cor_matrix = map(data, ~ cor(.x[, c("xDiam", "xSugar")],
use = "pairwise.complete.obs"))
)
# Correlation matrices by population
cors_by_pop <- mean_plant_data %>%
group_by(populationID) %>%
nest() %>%
mutate(
corrs = map(data, ~ cor(.x[, c("xDiam", "xSugar")],
use = "pairwise.complete.obs"))
)
mean_plant_data %>%
filter(populationID == "Carlos_Pellegrini") %>%
select(xDiam, xSugar) %>%
str()
# Correlation matrices by population
cors_by_pop <- mean_plant_data %>%
group_by(populationID) %>%
nest() %>%
mutate(
corrs = map(
data,
~ {
d <- .x %>%
select(xDiam, xSugar) %>%
filter(complete.cases(xDiam, xSugar))
if (nrow(d) < 2) {
return(NA_real_)
}
cor(d$xDiam, d$xSugar)
}
)
)
# Correlation matrices by population
cors_by_pop <- mean_plant_data %>%
group_by(populationID) %>%
summarise(
n = sum(!is.na(xDiam) & !is.na(xSugar)),
r = if (n >= 2) {
cor(xDiam[!is.na(xDiam) & !is.na(xSugar)],
xSugar[!is.na(xDiam) & !is.na(xSugar)])
} else {
NA_real_
},
.groups = "drop"
)
cors_by_pop
# Print results
cors_by_pop$corrs %>% map(~ round(.x, 3))
cors_by_pop$corrs
# Print results
cors_by_pop %>% map(~ round(.x, 3))
cors_by_pop
cors_by_pop
# Load plant-level data
plant_data <- read.csv(here("data", "Passionflower_pops.csv"))
# Sample sizes per population
plant_data %>%
group_by(populationID) %>%
summarise(n_plant = n())
# Group support types into broader categories
plant_data <- plant_data %>%
mutate(
support_group = case_when(
support %in% c("brick_pile", "light_post", "metal_sheet") ~ "Human structures",
support %in% c("fence", "fence_gate", "living_fence", "wire_fence") ~ "Fence",
support %in% c("bush", "standing_dead_bush", "unidentified_bush",
"Baccharis_sp", "Eryngium_sp", "Lycium_cestroides") ~ "Bush",
support == "vine" ~ "Vine",
support == "Opuntia_sp" ~ "Cacti",
TRUE ~ "Tree"
)
)
df_models <- plant_data %>%
group_by(populationID) %>%
nest() %>%
mutate(
data_scaled = map(data, ~ {
z <- scale(data.frame(
zcrop  = .x$fruit_crop,
zdiam  = .x$xDiam,
zsugar = .x$xSugar
)) %>% as.data.frame()
na.omit(bind_cols(z, W = .x$pecked_fruits))
}),
k_val = map_int(data_scaled, ~ round(nrow(.x)/4)),
gam_fit = map2(data_scaled, k_val, ~
gam(W ~ s(zcrop, k = .y) +
s(zdiam, k = .y) +
s(zsugar, k = .y),
family = nb(),
data = .x)
)
)
# Correlations by population
cors_by_pop <- mean_plant_data %>%
filter(populationID != "Santa_Fe") %>%
group_by(populationID) %>%
nest() %>%
mutate(
corrs = map(
data,
~ cor(.x[, c("xDiam", "xSugar")],
use = "pairwise.complete.obs")
)
)
head(mean_plant_data)
View(mean_plant_data)
# Correlations by population
mean_plant_data %>%
filter(populationID != "Santa_Fe") %>%
summarise(
r = cor(xDiam, xSugar, use = "pairwise.complete.obs")
)
cors_by_pop <- mean_plant_data %>%
filter(!is.na(xSugar)) %>%
mutate(
xDiam = as.numeric(xDiam),
xSugar = as.numeric(xSugar)
) %>%
group_by(populationID) %>%
summarise(
r = cor(xDiam, xSugar, use = "pairwise.complete.obs"),
.groups = "drop"
)
cors_by_pop
plant_data
