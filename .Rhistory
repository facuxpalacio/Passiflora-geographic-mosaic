head(plant_data)
# Load plant-level data
plant_data <- read.csv(here("data", "Passionflower_pops.csv"))
traits <- c("fruit_crop", "xDiam", "xSugar", "xPulpSeed")
populations <- unique(plant_data$populationID)
results_moments <- map_dfr(populations, function(pop) {
dat <- plant_data %>%
filter(populationID == pop) %>%
select(all_of(traits), W) %>%
drop_na()
if (nrow(dat) < 3) return(NULL)
res <- moments.differentials(
z = dat[, traits],
W = dat$W,
n.boot = 1000,
standardized = FALSE
)
res %>%
rownames_to_column("term") %>%
filter(
grepl("^B[0-9]+$", term) |
grepl("^G[0-9]+$", term)
) %>%
mutate(
populationID = pop,
differential = substr(term, 1, 1),
trait = traits[
as.numeric(gsub("[A-Z]", "", term))
],
.before = 1
)
})
