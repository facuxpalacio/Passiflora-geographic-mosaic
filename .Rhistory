knitr::opts_chunk$set(
echo = TRUE,
warning = FALSE,
message = FALSE,
fig.width = 7,
fig.height = 5,
fig.align = "center"
)
##### Population density (predictor 5)
populationID <- c("CP", "EC", "ER", "LZ", "LP", "MG", "RA",
"SF", "SM", "TU")
pop_density <- c(760, 134, 910, 4115, 239,
0, 874, 1507, 695, 5445)
pop_df <- data.frame(populationID, pop_density)
log_pop <- log(pop_df$pop_density + 1)
# Load plant-level data
plant_data <- read.csv(here("data", "Passionflower_pops.csv"))
x<-plant_data %>% gorup_by(populationID) %>% summarize(rem=mean(pecked_fruits,na.rm=T)
)
x<-plant_data %>% group_by(populationID) %>% summarize(rem=mean(pecked_fruits,na.rm=T))
plot(log_pop,x$rem)
coords <- plant_data %>%
group_by(populationID) %>%
summarise(
Long = mean(as.numeric(longitude), na.rm = TRUE),
Lat  = mean(as.numeric(latitude), na.rm = TRUE)
)
coords$populationID <- c("CP", "EC", "ER", "LZ", "LP", "MG", "RA",
"SF", "SM", "TU")
coords[10, 2] <- -65.26979233 # Longitude Tucuman
coords[10, 3] <- -26.80470395 # Latitude Tucuman
coords[c(4,5), ] <- coords[c(5,4), ] # switch LZ and LP
datos<-data.frame(coords,log_pop,rem=x$rem)
m<-glm(rem~log_pop+latitude,family=poisson,data=datos)
head(datos)
m<-glm(rem~log_pop+Lat,family=poisson,data=datos)
summary(m)
plot(log_pop,x$rem)
m<-glm(rem~log_pop,family=poisson,data=datos)
summary(m)
m<-glm(rem~pop_density,family=poisson,data=datos)
summary(m)
grads <- read.table(here("data", "grads_passi.txt"), head = T)
head(grads)
crop<-subset(grads,Parameter=="B-zcrop")
datos<-data.frame(coords,log_pop,rem=x$rem,crop)
plot(datos$log_pop,datos$crop)
datos$crop
head(datos)
plot(datos$log_pop,datos$estimates)
crop<-subset(grads,Parameter=="B-zdiam")
datos<-data.frame(coords,log_pop,rem=x$rem,crop)
plot(datos$log_pop,datos$estimates)
m<-glm(estimates~log_pop,datos)
m<-lm(estimates~log_pop,datos)
summary(m)
library(nlme)
m <- gls(estimates ~ log_pop,
weights = varPower(form = ~ log_pop),
data = datos)
m <- lm(estimates ~ log_pop, data = datos)
library(sandwich)
library(lmtest)
coeftest(m, vcov = vcovHC(m, type = "HC3"))
