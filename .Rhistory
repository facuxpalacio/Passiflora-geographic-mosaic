) +
scale_size_continuous(
name = "Selection intensity"
) +
scale_alpha_identity() +
facet_wrap(~trait) +
theme_classic() +
labs(
x = "Longitude",
y = "Latitude"
) +
theme(
legend.position = "right"
)
dat<-read.table("C:/RD/grads_passi.txt",head=T)
library(ggplot2)
library(dplyr)
# Solo gradientes lineales
plot_dat <- dat %>%
filter(grepl("^B_", Parameter)) %>%
mutate(
trait = case_when(
Parameter == "B_zcrop"  ~ "Fruit crop size",
Parameter == "B_zdiam"  ~ "Fruit size",
Parameter == "B_zseeds" ~ "Seed number"
),
sig = P.value < 0.05,
alpha_val = ifelse(sig, 1, 0.25)
)
ggplot(plot_dat, aes(x = Long, y = Lat)) +
geom_point(
aes(size = abs(estimates),
fill = estimates,
alpha = alpha_val),
shape = 21,
color = "black"
) +
scale_fill_gradient2(
low = "red",
mid = "white",
high = "blue",
midpoint = 0,
name = "Linear selection\n(β)"
) +
scale_size_continuous(
name = "Selection intensity"
) +
scale_alpha_identity() +
facet_wrap(~trait) +
theme_classic() +
labs(
x = "Longitude",
y = "Latitude"
) +
theme(
legend.position = "right"
)
