)
ggplot(df, aes(x = sugar_brix, y = populationID)) +
geom_density_ridges(
fill = "grey80",
color = "black",
alpha = 0.8,
scale = 2,
rel_min_height = 0.01
) +
geom_text(
data = medias,
aes(
x = xmax-1,
y = as.numeric(populationID) + 0.05,
label = paste0("n = ", n)
),
hjust = -0.1,
vjust = 0,
size = 4
)  +
theme_minimal(base_size = 14) +
xlab("Sugar concentration (°Brix)") +
ylab("Population") +
theme(
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank()
)
