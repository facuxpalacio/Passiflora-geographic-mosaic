results_moments <- map_dfr(populations, function(pop) {
map_dfr(traits, function(trait) {
# Datos disponibles para ESTE rasgo + W
dat <- plant_data %>%
filter(populationID == pop) %>%
select(all_of(c(trait, "pecked_fruits"))) %>%
filter(
!is.na(.data[[trait]]),
!is.na(W)
)
# Si no hay datos, devolver NA
if (nrow(dat) == 0) {
return(tibble(
populationID = pop,
trait = trait,
n = 0,
B = NA_real_,
B_SE = NA_real_,
B_p = NA_real_,
G = NA_real_,
G_SE = NA_real_,
G_p = NA_real_
))
}
# Con muy pocos individuos no tiene sentido bootstrap
if (nrow(dat) < 3) {
return(tibble(
populationID = pop,
trait = trait,
n = nrow(dat),
B = NA_real_,
B_SE = NA_real_,
B_p = NA_real_,
G = NA_real_,
G_SE = NA_real_,
G_p = NA_real_
))
}
# moments.differentials para ESTE rasgo
res <- moments.differentials(
z = dat[, trait, drop = FALSE],
W = dat$pecked_fruits,
n.boot = 1000,
standardized = TRUE
)
tibble(
populationID = pop,
trait = trait,
n = nrow(dat),
B = res["B1", "Coefficient"],
B_SE = res["B1", "SE"],
B_p = res["B1", "P-value"],
G = res["G1", "Coefficient"],
G_SE = res["G1", "SE"],
G_p = res["G1", "P-value"]
)
})
})
