plant_data <- plant_data %>%
mutate(
support_group = case_when(
# Human-made structures
support %in% c("brick_pile", "light_post", "metal_sheet") ~
"Other human-made structures",
# Fence
support %in% c("fence", "fence_gate", "living_fence", "wire_fence") ~
"Fence",
# Bush / shrubs
support %in% c(
"bush", "standing_dead_bush", "unidentified_bush",
"Baccharis_sp", "Eryngium_sp", "Lycium_cestroides"
) ~ "Bush",
# Vine
support == "vine" ~ "Vine",
# Cactus
support == "Opuntia_sp" ~ "Cacti",
# Everything else
TRUE ~ "Tree"
)
)
ggplot(plant_data, aes(x = populationID, fill = support_group)) +
geom_bar(position = "fill") +
coord_flip() +
scale_y_continuous(labels = scales::percent_format()) +
labs(
x = "Population",
y = "Percentage",
fill = "Support"
) +
theme_bw()
