set.seed(1)
results_moments <- map_dfr(populations, function(pop) {
map_dfr(traits, function(trait) {
# Available data for this trait + fitness
dat <- plant_data %>%
filter(populationID == pop) %>%
select(all_of(c(trait, "pecked_fruits"))) %>%
filter(
!is.na(.data[[trait]]),
!is.na(pecked_fruits)
)
# If no data available, return NA
if (nrow(dat) == 0) {
return(tibble(
populationID = pop,
trait = trait,
n = 0,
B = NA_real_,
B_SE = NA_real_,
B_p = NA_real_,
G = NA_real_,
G_SE = NA_real_,
G_p = NA_real_
))
}
# With very few individuals, bootstrap cannot be computed
if (nrow(dat) < 3) {
return(tibble(
populationID = pop,
trait = trait,
n = nrow(dat),
B = NA_real_,
B_SE = NA_real_,
B_p = NA_real_,
G = NA_real_,
G_SE = NA_real_,
G_p = NA_real_
))
}
# moments.differentials for this trait
zW <- na.omit(dat)
res <- moments.differentials(
z = zW[, trait, drop = FALSE],
W = zW$pecked_fruits,
n.boot = 1000,
standardized = TRUE
)
tibble(
populationID = pop,
trait = trait,
n = nrow(dat),
B = res["B1", "Coefficient"],
B_SE = res["B1", "SE"],
B_p = res["B1", "P-value"],
G = res["G1", "Coefficient"],
G_SE = res["G1", "SE"],
G_p = res["G1", "P-value"]
)
})
})
results_moments
