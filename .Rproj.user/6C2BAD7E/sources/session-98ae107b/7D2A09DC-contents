df2 <- grads %>%
  mutate(
    sig = P.value < 0.05,
    
    grad_type = case_when(
      str_detect(Parameter, "^B-") ~ "Linear",
      str_detect(Parameter, "^G-") & !str_detect(Parameter, "-z.*-z") ~ "Quadratic",
      str_detect(Parameter, "^G-") & str_detect(Parameter, "-z.*-z") ~ "Correlational"
    )
  )

# Linear y quadratic
main_df <- df2 %>%
  filter(grad_type %in% c("Linear", "Quadratic")) %>%
  mutate(
    trait = str_extract(Parameter, "z[^-]+") %>%
