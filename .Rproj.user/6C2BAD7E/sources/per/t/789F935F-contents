##################################################################
### SIMULATIONS TO TEST SIMPLIFIED N-MIXTURE MODEL
### COMMON DETECTION PROBABILITY ACROSS ALL SPECIES
##################################################################

set.seed(2026)

library(R2jags)
library(ggplot2)
library(patchwork)
library(dplyr)
library(tidyr)


##################################################################
### 1. STUDY DESIGN
##################################################################

n_species <- 83
n_pops <- 10
n_plants <- rep(20, n_pops)


##################################################################
### 2. TRUE PARAMETERS
##################################################################

# ---------------------------------------------------------------
# Population-specific ecological parameters
# ---------------------------------------------------------------

alpha_true <- rnorm(
  n_pops,
  mean = -0.3,
  sd = 0.4
)

beta_true <- rnorm(
  n_pops,
  mean = 1,
  sd = 1
)


# ---------------------------------------------------------------
# COMMON DETECTION PROBABILITY
# ---------------------------------------------------------------

p_true <- 0.6

##################################################################
### 3. REGIONAL ABUNDANCE PREDICTOR
##################################################################

log_pool <- matrix(
  rnorm(
    n_species * n_pops,
    mean = 1.5,
    sd = 0.8
  ),
  nrow = n_species,
  ncol = n_pops
)


# Center log_pool within populations

log_pool_c <- sweep(
  log_pool,
  2,
  colMeans(log_pool)
)


##################################################################
### 4. KNOWN REGIONAL PRESENCE/ABSENCE
##################################################################

presence_by_pop_true <- matrix(
  rbinom(
    n_species * n_pops,
    size = 1,
    prob = 0.85
  ),
  nrow = n_species,
  ncol = n_pops
)


##################################################################
### 5. SIMULATE LATENT ABUNDANCE
##################################################################

lambda_true <- matrix(
  0,
  nrow = n_species,
  ncol = n_pops
)

N_true <- matrix(
  0,
  nrow = n_species,
  ncol = n_pops
)


for (i in 1:n_species) {
  
  for (k in 1:n_pops) {
    
    if (presence_by_pop_true[i, k] == 1) {
      
      lambda_true[i, k] <-
        exp(
          alpha_true[k] +
            beta_true[k] * log_pool_c[i, k]
        )
      
      N_true[i, k] <- rpois(
        1,
        lambda_true[i, k]
      )
      
    } else {
      
      lambda_true[i, k] <- 0
      
      N_true[i, k] <- 0
      
    }
  }
}

##################################################################
### 6. SIMULATE OBSERVED VISITS
##################################################################

C_sim <- array(
  NA,
  dim = c(
    n_species,
    max(n_plants),
    n_pops
  )
)


for (k in 1:n_pops) {
  
  for (i in 1:n_species) {
    
    for (j in 1:n_plants[k]) {
      
      if (presence_by_pop_true[i, k] == 1) {
        
        C_sim[i, j, k] <-
          rbinom(
            1,
            size = N_true[i, k],
            prob = p_true
          )
        
      } else {
        
        C_sim[i, j, k] <- 0
      }
    }
  }
}


##################################################################
### 7. DATA LIST FOR JAGS
##################################################################

data_list_sim <- list(
  
  C = C_sim,
  
  log_pool_c = log_pool_c,
  
  
  n_species = n_species,
  
  n_pops = n_pops,
  
  n_plants = n_plants,
  
  presence_by_pop = presence_by_pop_true
)


##################################################################
### 8. INITIAL VALUES
##################################################################

make_inits_sim <- function(
    C,
    presence,
    n_species,
    n_pops
) {
  
  N_init <- matrix(
    0,
    nrow = n_species,
    ncol = n_pops
  )
  
  
  for (i in 1:n_species) {
    
    for (k in 1:n_pops) {
      
      obs <- C[i, , k]
      
      obs <- obs[!is.na(obs)]
      
      maxC <- ifelse(
        length(obs) == 0,
        0,
        max(obs)
      )
      
      if (presence[i, k] == 1) {
        
        N_init[i, k] <-
          max(maxC, 1) +
          rpois(1, 2)
        
      } else {
        
        N_init[i, k] <- 0
        
      }
    }
  }
  
  
  list(
    
    N = N_init,
    
    alpha = rnorm(
      n_pops,
      0,
      0.5
    ),
    
    beta = rnorm(
      n_pops,
      1,
      0.3
    ),
    
    mu_alpha = 0,
    
    mu_beta = 1,
    
    tau_alpha = 1,
    
    tau_beta = 1,
    
    p = runif(
      1,
      0.4,
      0.8
    )
  )
}


##################################################################
### 9. THREE CHAINS
##################################################################

inits_sim <- list(
  
  make_inits_sim(
    C_sim,
    presence_by_pop_true,
    n_species,
    n_pops
  ),
  
  make_inits_sim(
    C_sim,
    presence_by_pop_true,
    n_species,
    n_pops
  ),
  
  make_inits_sim(
    C_sim,
    presence_by_pop_true,
    n_species,
    n_pops
  )
)


##################################################################
### 10. JAGS MODEL
##################################################################
cat("

model {

  ############################################################
  # Ecological process
  ############################################################

  for (k in 1:n_pops) {

    for (i in 1:n_species) {

      ########################################################
      # Regional abundance
      ########################################################

      lambda[i,k] <- presence_by_pop[i,k] * exp(
        alpha[k] +
        beta[k] * log_pool_c[i,k]
      )


      ########################################################
      # Latent abundance
      ########################################################

      N[i,k] ~ dpois(
        lambda[i,k]
      )


      ########################################################
      # Observations
      ########################################################

      for (j in 1:n_plants[k]) {

        C[i,j,k] ~ dbin(
          p,
          N[i,k]
        )

      }

    }

  }


  ############################################################
  # Population-specific ecological parameters
  ############################################################

  for (k in 1:n_pops) {

    alpha[k] ~ dnorm(
      mu_alpha,
      tau_alpha
    )

    beta[k] ~ dnorm(
      mu_beta,
      tau_beta
    )

  }


  ############################################################
  # Hyperparameters
  ############################################################

  mu_alpha ~ dnorm(
    0,
    0.01
  )

  mu_beta ~ dnorm(
    0,
    0.01
  )


  tau_alpha ~ dgamma(
    1,
    1
  )

  tau_beta ~ dgamma(
    1,
    1
  )


  ############################################################
  # COMMON DETECTION PROBABILITY
  ############################################################

  p ~ dbeta(
    1,
    1
  )

}

", file = "Nmix_A_common_p_beta_pop.txt")


##################################################################
### 11. PARAMETERS TO MONITOR
##################################################################

params <- c(
  "alpha",
  "beta",
  "mu_alpha",
  "mu_beta",
  "tau_alpha",
  "tau_beta",
  "p",
  "N"
)

##################################################################
### 12. RUN JAGS
##################################################################

fit_sim <- jags(
  
  data = data_list_sim,
  
  inits = inits_sim,
  
  parameters.to.save = params,
  
  model.file = "Nmix_A_common_p_beta_pop.txt",
  
  n.chains = 3,
  
  n.iter = 20000,
  
  n.burnin = 5000,
  
  n.thin = 5
)

fit_sim <- jags(
  
  data = data_list_sim,
  
  inits = inits_sim,
  
  parameters.to.save = params,
  
  model.file = "Nmix_B_common_p_beta.txt",
  
  n.chains = 3,
  
  n.iter = 20000,
  
  n.burnin = 5000,
  
  n.thin = 5
)
